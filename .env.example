# Copy to .env and fill in. NOTE: Next.js copies .env into the standalone build,
# so these values end up inside the packaged desktop app (DMG) — do not put real
# credentials here for builds you share with others; use Settings instead
# (stored encrypted in the OS keychain).

# NVIDIA NIM API key (build.nvidia.com) — seeded into an "NVIDIA NIM" AI
# connection on first run and used as the default vision model for read_image.
NVIDIA_API_KEY=

# Shared catalog database (agents, skills, knowledge) — PostgreSQL public URL,
# e.g. Railway → Postgres → Connect → Public Network.
# Settings → Shared database overrides this value.
SHARED_DATABASE_URL=postgresql://postgres:PASSWORD@reseau.proxy.rlwy.net:53957/railway
