# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=agentplatform
POSTGRES_PASSWORD=changeme-dev
POSTGRES_DB=agentplatform

# Full async DSN used by core service (SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://agentplatform:changeme-dev@localhost:5432/agentplatform

# ── Core gRPC service ───────────────────────────────────────────────────────
CORE_HOST=localhost
CORE_PORT=50051

# ── Gateway (FastAPI) ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Bearer secret — frontend must send: Authorization: Bearer <value>
# Generate a strong random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_SECRET=changeme-dev-secret

# ── Logging ─────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
